@model InterviewsControl.Models.JobApplication
@using InterviewsControl.Models.Enums

@{
    ViewData["Title"] = "新增求職紀錄";
}

<h2>新增求職紀錄</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="CompanyName" class="control-label"></label>
                <input asp-for="CompanyName" class="form-control" placeholder="例如：台積電、鴻海" />
                <span asp-validation-for="CompanyName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="JobTitle" class="control-label"></label>
                <input asp-for="JobTitle" class="form-control" placeholder="例如：ASP.NET Core 後端工程師" />
                <span asp-validation-for="JobTitle" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="JobUrl" class="control-label"></label>
                <input asp-for="JobUrl" class="form-control" placeholder="104 或企業招募網址" />
                <span asp-validation-for="JobUrl" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="AppliedDate" class="control-label"></label>
                <input asp-for="AppliedDate" class="form-control" />
                <span asp-validation-for="AppliedDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<ApplicationStatus>()" class="form-control"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="面試前需要準備的資料或筆記..."></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="儲存紀錄" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">返回列表</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}